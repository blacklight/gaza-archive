# The base URL where the application will be accessible.
BASE_URL="http://localhost:8000"

# The path where the application will store its data.
# All media files will be under STORAGE_PATH/media.
# In Docker images, the database will be at STORAGE_PATH/app.db.
STORAGE_PATH="/data"

# The host and port for the API server.
API_HOST="0.0.0.0"
API_PORT=8000

# The URL of the source website to crawl for verified accounts.
ACCOUNTS_SOURCE_URL="https://gaza-verified.org/people.json"

# Database connection URL (SQLAlchemy format).
# Note that for other databases you may need to install additional drivers.
DB_URL="sqlite:///data/app.db"

# Whether to download media files (images, videos) from posts.
DOWNLOAD_MEDIA=1

# User agent string to use for HTTP requests.
USER_AGENT="GazaVerifiedArchiveBot/1.0"

# Custom User-Agent header to use for campaign scraper requests only, e.g. to
# mimic a browser for platforms that block bot user agents.
# Leave empty to use USER_AGENT.
# CAMPAIGN_USER_AGENT="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36"

# Interval (in seconds) between successive crawls.
POLL_INTERVAL=300

# Maximum time (in seconds) to wait for HTTP requests.
HTTP_TIMEOUT=10

# Number of concurrent crawlers.
CONCURRENT_REQUESTS=5

# Enable or disable the crawlers (1 to enable, 0 to disable).
# Disabling it will stop all crawling activities. The application will only
# serve existing data.
ENABLE_CRAWLERS=1

# Enable fetching campaign data from fundraising platforms.
ENABLE_CAMPAIGN_CRAWLERS=0

# Debug mode (1 to enable, 0 to disable).
DEBUG=0

# Profiles to exclude from crawling (comma-separated).
EXCLUDE_PROFILES="https://mastodon.ar.al/@aral,https://kafeneio.social/@casey"

# Hide donor names on the API (1 to enable, 0 to disable).
HIDE_DONORS=0

# Hide media attachment on the API and the frontend (1 to enable, 0 to disable).
HIDE_MEDIA=0

# A pool of HTTP(S) or SOCKS proxies used to route campaign source requests
# through. Some fundraising platforms aggressively rate-limit or block certain
# VPS providers, so requests can be spread across multiple exit IPs.
# Proxies are selected in round-robin order; when a proxy gets rate-limited
# (403/429) or fails, it is put in cool-down and the next proxy is tried.
# Comma-separated list; leave it empty to disable the proxy pool.
# Entries may be http:// or https:// URLs, socks4://, socks4a://, socks5://
# (local DNS resolution) or socks5h:// (DNS resolved by the proxy,
# recommended) URLs, or plain host:port which defaults to http://.
# Optional auth: scheme://user:pass@host:port.
# CAMPAIGN_URL_HTTP_PROXIES="http://user:pass@10.0.0.1:3128,socks5h://10.0.0.2:1080,10.0.0.3:3128"
#
# CAMPAIGN_URL_HTTP_PROXY is a legacy alias for CAMPAIGN_URL_HTTP_PROXIES.
# It also accepts a comma-separated list, and entries from both variables
# are merged into the same pool.
# CAMPAIGN_URL_HTTP_PROXY="10.0.0.254:8888"

# Restrict proxying to specific campaign sources (comma-separated).
# Known source names: chuffed, gofundme, steunactie, whydonate.
# Leave empty to route all campaign source requests through the proxy pool.
# CAMPAIGN_URL_PROXY_SOURCES="chuffed,gofundme"

# How many seconds a proxy stays in cool-down after a rate limit or a failure.
# When the upstream response provides a Retry-After header, that value is used
# instead (capped at 300 seconds).
# CAMPAIGN_URL_PROXY_COOLDOWN=60

# Disable TLS certificate verification for requests routed through the proxy
# pool (1 to enable, 0 to disable, default 0). Useful for https:// proxies
# with self-signed certificates or MITM proxies; note that it also disables
# verification of the target site's certificate through the tunnel, so only
# enable it if you trust your proxies.
# CAMPAIGN_URL_PROXY_INSECURE=0

# Either a paid exchangerate-api.com or a free fixer.io API key are required
# if you want to enable campaign crawlers, unless you want to apply only today's
# exchange rates (which may be inaccurate for older campaigns).

# exchangerate-api.com API key for currency conversion (optional).
# You can get a free API key from https://www.exchangerate-api.com/
# EXCHANGE_RATE_API_KEY="your_exchangerate_api_key_here"

# fixer.io API key for currency conversion (optional).
# You can get a free API key from https://fixer.io/signup/free
# FIXER_IO_API_KEY="your_fixer_io_api_key_here"

# List of account URLs or FQDNs whose campaigns should be excluded from the
# campaign dashboard (comma-separated).
EXCLUDE_CAMPAIGN_ACCOUNTS="https://mastodon.social/@reem_osama,https://mastodon.social/@Sakhergaza13"

# Mastodon bot settings. Comment them or leave them empty to disable the
# Mastodon accounts bots.
# You can create a new application at https://mastodon.example.com/settings/applications.
# You need to enable at least the "profile", "read:search" and "write:statuses" scopes.
# Then copy the instance URL and the generated access token here.
#
# Mastodon accounts bot settings. This bot periodically boosts posts from
# verified accounts.
# MASTODON_ACCOUNTS_BOT_INSTANCE_URL="https://mastodon.example.com"
# MASTODON_ACCOUNTS_BOT_ACCESS_TOKEN="your_mastodon_access_token_here"
#
# Mastodon campaigns bot settings. This bot periodically writes posts about
# under-funded campaigns.
# MASTODON_CAMPAIGNS_BOT_INSTANCE_URL="https://mastodon.example.com"
# MASTODON_CAMPAIGNS_BOT_ACCESS_TOKEN="your_mastodon_access_token_here"
#
# Time window (in days) to calculate the amount raised by campaigns for the
# Mastodon campaigns bot.
# MASTODON_CAMPAIGNS_BOT_TIME_WINDOW_DAYS=7
#
# Minimum amount (in USD) a campaign must have raised in the past week to be
# ignored by the bot.
# MASTODON_CAMPAIGNS_BOT_MIN_RAISED_AMOUNT=200
#
# How often (in hours) the Mastodon bots should post/boost.
# MASTODON_BOT_POST_INTERVAL_HOURS=12

# Account suspension state monitoring settings.
# This feature checks if verified accounts have been suspended, limited, or
# deleted on various Mastodon servers to track account availability.

# Enable or disable account suspension state checking (1 to enable, 0 to disable).
# ACCOUNT_STATE_CHECK_ENABLED=0

# Interval (in seconds) between suspension state checks.
# Default: 3600 (1 hour). Recommended range: 1800-7200 to respect rate limits.
# ACCOUNT_STATE_CHECK_INTERVAL=3600

# Number of concurrent workers for checking account states across servers.
# Default: 10. Reduce if you encounter rate limiting issues.
# ACCOUNT_STATE_CHECK_WORKERS=10

# Number of top Mastodon servers (by monthly active users) to check from fedidb.
# Default: 50. Higher values provide more coverage but increase API calls.
# ACCOUNT_STATE_SERVERS_LIMIT=50

# Custom list of Mastodon servers to check (comma-separated).
# If provided, this overrides the automatic fedidb server discovery.
# Each account's home instance is always checked regardless of this setting.
# ACCOUNT_STATE_CUSTOM_SERVERS="mastodon.social,mas.to,mstdn.social"

# How many hours an account must be unreachable or removed from the source list
# before it is marked as DELETED.
# Default: 72.0 (3 days). Accepts float values, e.g. 0.5 for 30 minutes.
# DELETED_AFTER_DOWN_HOURS=72.0
